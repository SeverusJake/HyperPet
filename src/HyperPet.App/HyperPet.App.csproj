<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <StartupObject>HyperPet.App.App</StartupObject>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>HyperPet</AssemblyName>
    <Product>HyperPet</Product>
    <ApplicationIcon>Assets\HyperPet.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WPF owns startup and DPI; WinForms is used only for native helpers/tray. -->
    <NoWarn>$(NoWarn);WFAC010;WFO0003</NoWarn>
    <Version>0.7.1</Version>



  </PropertyGroup>
  <ItemGroup Condition="'$(SelfContained)' == 'true'">
    <FrameworkReference Update="Microsoft.NETCore.App" RuntimeFrameworkVersion="10.0.15" />
    <FrameworkReference Update="Microsoft.WindowsDesktop.App" RuntimeFrameworkVersion="10.0.15" />
  </ItemGroup>
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>
  <ItemGroup>
    <!-- UseWindowsForms=true (needed for System.Windows.Forms.Cursor in Summon)
         injects these implicit global usings, which collide with WPF and
         image types. Remove them to restore the pre-WinForms using set;
         the WinForms assembly reference itself stays. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\HyperPet.Core\HyperPet.Core.csproj" />
    <ProjectReference Include="..\HyperPet.Windows\HyperPet.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="HyperPet.App.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="4.155.0" />
    <PackageReference Include="Velopack" Version="1.0.1" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Assets\Pets\**\*.*" />
    <Content Include="Assets\Pets\**\*.*" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Assets\Package\*.png" />
    <Resource Include="Assets\HyperPet.ico" />
    <None Include="Assets\HyperPet.ico" Link="Assets\HyperPet.ico" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Package.appxmanifest" />
    <None Update="SkiaSharp-LICENSE.txt;SkiaSharp-THIRD-PARTY-NOTICES.txt"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
